# Optional environment overrides for Hypermesh Media Hub
# Copy this file to .env and fill in values only if needed.

# Bind host and port (defaults: 0.0.0.0 and 8000)
HOST=0.0.0.0
PORT=8000

# Optional GitHub token for syncing APK releases from a private fork/repo
# Leave empty when syncing from the public sahaveer/hypermesh-mobile-app repo
APK_GITHUB_TOKEN=
